    "url": "https://github.com/oldruntu1205/dsh-duty/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "agent",
    "ticket",
    "duty",
    "automation",
    "policy"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
